rules_version = '2';

// Deploy with:  npx firebase-tools deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {

    // The shop admins: one document per admin in admins/{uid}, added by hand in the
    // Firebase console (no app can write there).
    function isOwner() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Images are base64 data URLs; the app re-compresses anything over 700 KB
    // (HARD_LIMIT in src/utils/imageCompression.js).
    function validImage(s) {
      return s is string && s.size() > 0 && s.size() <= 700000;
    }

    // Focus point of a photo (what stays in view when it's cropped to a square), in percent.
    // Optional: older photos don't have it and the shop then uses 50/50 (the centre).
    function validFocusValue(v) {
      return v is number && v >= 0 && v <= 100;
    }

    function validFocus(d) {
      return (!('focusX' in d) || validFocusValue(d.focusX))
        && (!('focusY' in d) || validFocusValue(d.focusY));
    }

    // Catch mistakes in what the admin writes (e.g. a price saved as text, a stray field).
    // Text limits match the maxLength of the admin form fields.
    // focusX/focusY repeat the main photo's focus point, for the category cards.
    function validProduct(p) {
      return p.keys().hasOnly(['name', 'price', 'category', 'subcategory', 'shortDescription',
                               'fullDescription', 'thumbnail', 'available', 'createdAt',
                               'focusX', 'focusY'])
        && validFocus(p)
        && p.name is string && p.name.size() > 0 && p.name.size() <= 150
        && p.price is number && p.price > 0 && p.price <= 100000
        && p.category is string && p.category.size() > 0 && p.category.size() <= 60
        && (p.subcategory == null || (p.subcategory is string && p.subcategory.size() <= 60))
        // Optional: may be missing or empty; if present it must be text.
        && (!('shortDescription' in p)
            || (p.shortDescription is string && p.shortDescription.size() <= 120))
        && p.fullDescription is string && p.fullDescription.size() <= 5000
        && validImage(p.thumbnail)
        && p.available is bool;
    }

    function validCategory(c) {
      return c.keys().hasOnly(['name', 'order', 'coverImage', 'subcategories'])
        && c.name is string && c.name.size() > 0 && c.name.size() <= 60
        && c.order is int && c.order >= 0
        && c.subcategories is list && c.subcategories.size() <= 30
        && (c.get('coverImage', null) == null || validImage(c.coverImage));
    }

    function validText(d) {
      return d.keys().hasOnly(['text', 'updatedAt'])
        && d.text is string && d.text.size() <= 20000
        && d.updatedAt == request.time;
    }

    // The shop sees only available products; admins see everything.
    // (Shop queries must therefore filter on available == true.)
    match /products/{productId} {
      allow read: if resource.data.available == true || isOwner();
      allow create: if isOwner()
        && validProduct(request.resource.data)
        && request.resource.data.createdAt == request.time;
      allow update: if isOwner()
        && validProduct(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isOwner();
    }

    // The parent doc only held the old single image; admins can still read/delete it for cleanup.
    match /productImages/{productId} {
      allow read, delete: if isOwner();

      // Product photos: productImages/{productId}/photos/{photoId} — { image, order, focusX?, focusY? }.
      // Readable by the shop only while the product itself is available.
      match /photos/{photoId} {
        allow read: if isOwner()
          || get(/databases/$(database)/documents/products/$(productId)).data.available == true;
        allow create, update: if isOwner()
          && request.resource.data.keys().hasOnly(['image', 'order', 'focusX', 'focusY'])
          && validImage(request.resource.data.image)
          && validFocus(request.resource.data)
          && request.resource.data.order is int
          && request.resource.data.order >= 0
          && request.resource.data.order < 6;
        allow delete: if isOwner();
      }
    }

    // Shop categories. The document id is permanent (products store it).
    match /categories/{categoryId} {
      allow read: if true;
      allow create, update: if isOwner() && validCategory(request.resource.data);
      allow delete: if isOwner();
    }

    // Only these three settings documents exist; anything else under settings/ is denied.
    match /settings/story {
      allow read: if true;
      allow create, update: if isOwner() && validText(request.resource.data);
      allow delete: if isOwner();
    }

    match /settings/terms {
      allow read: if true;
      allow create, update: if isOwner() && validText(request.resource.data);
      allow delete: if isOwner();
    }

    match /settings/delivery {
      allow read: if true;
      allow create, update: if isOwner()
        && request.resource.data.keys().hasOnly(['fee', 'updatedAt'])
        && request.resource.data.fee is number
        && request.resource.data.fee >= 0
        && request.resource.data.fee <= 1000
        && request.resource.data.updatedAt == request.time;
      allow delete: if isOwner();
    }

    // Each signed-in user may check only their own admin entry (the admin page does this).
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
    }

    // Everything else stays locked (no rule = denied).
  }
}
