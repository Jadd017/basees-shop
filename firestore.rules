rules_version = '2';

// Deploy with:  npx firebase-tools deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {

    // The shop admins: one document per admin in admins/{uid}, added by hand in the
    // Firebase console (no app can write there).
    function isOwner() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Catch typos in what the admin writes (e.g. a price saved as text).
    function validProduct(p) {
      return p.name is string && p.name.size() > 0
        && p.price is number && p.price > 0
        && p.category is string
        && (p.subcategory == null || p.subcategory is string)
        && p.shortDescription is string
        && p.fullDescription is string
        && p.thumbnail is string
        && p.available is bool;
    }

    function validCategory(c) {
      return c.name is string && c.name.size() > 0
        && c.order is number
        && c.subcategories is list
        && (!('coverImage' in c) || c.coverImage == null || c.coverImage is string);
    }

    // Anyone can read; only the admins can create, update or delete.
    match /products/{productId} {
      allow read: if true;
      allow create, update: if isOwner() && validProduct(request.resource.data);
      allow delete: if isOwner();
    }

    // Product photos: productImages/{productId}/photos/{photoId} — { image, order }.
    // (The parent doc only held the old single image; kept writable so it can be cleaned up.)
    match /productImages/{productId} {
      allow read: if true;
      allow create, update, delete: if isOwner();

      match /photos/{photoId} {
        allow read: if true;
        allow create, update: if isOwner()
          && request.resource.data.image is string
          && request.resource.data.order is number;
        allow delete: if isOwner();
      }
    }

    // Shop categories. The document id is permanent (products store it).
    match /categories/{categoryId} {
      allow read: if true;
      allow create, update: if isOwner() && validCategory(request.resource.data);
      allow delete: if isOwner();
    }

    match /settings/{docId} {
      allow read: if true;
      allow create, update, delete: if isOwner();
    }

    // Each signed-in user may check only their own admin entry (the admin page does this).
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
    }

    // Everything else stays locked (no rule = denied).
  }
}
