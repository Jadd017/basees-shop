# Copy to .env and fill in from Firebase console → Project settings → Your apps → Web app.
# (These values identify the project; access is protected by firestore.rules, not by hiding them.)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=


# App Check (reCAPTCHA Enterprise / Fraud Defense, score-based key). The site key is public.
VITE_RECAPTCHA_SITE_KEY=
# Only used by `npm run dev` (no VITE_ prefix: vite.config.js passes it to dev only). Generate it in
# Firebase console → App Check → Apps → ⋮ → Manage debug tokens. Keep it private.
APPCHECK_DEBUG_TOKEN=
