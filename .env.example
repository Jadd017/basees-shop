# Copy to .env and fill in from Firebase console → Project settings → Your apps → Web app.
# (These values identify the project; access is protected by firestore.rules, not by hiding them.)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# The only Google account allowed into /admin. Must match the email in firestore.rules.
VITE_ADMIN_EMAIL=
